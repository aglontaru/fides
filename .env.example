# ── LLM Configuration ─────────────────────────────────────────────────
LLM_PROVIDER=ollama                    # ollama | gemini
LLM_MODEL=llama3.1                     # Model name for the selected provider
OLLAMA_BASE_URL=http://ollama:11434    # Ollama server URL (Docker service name)

# Gemini (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Embedding Configuration ──────────────────────────────────────────
EMBEDDING_PROVIDER=ollama              # ollama | gemini
EMBEDDING_MODEL=nomic-embed-text       # Embedding model name
EMBEDDING_DIMENSIONS=768               # Must match the model's output dimensions

# ── Neo4j ─────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fides-dev-password

# ── MCP Server ───────────────────────────────────────────────────────
MCP_SERVER_URL=http://mcp-server:8000/mcp

# ── LangSmith Observability ──────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Fides

# ── Application ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
FIDES_API_HOST=0.0.0.0
FIDES_API_PORT=8080
DOCUMENT_STORAGE_PATH=/app/documents
